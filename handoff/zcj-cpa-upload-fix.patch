+def _codex_auth_filename(email: str, plan_type: str = "") -> str:
+    """Build the Codex auth filename recognized by CPA."""
+    safe_email = re.sub(r"[^A-Za-z0-9.@+_-]+", "-", str(email or "").strip())
+    safe_email = safe_email.strip(".-")
+    if not safe_email:
+        raise ValueError("email 为空，无法生成 Codex 凭证文件名")
+    safe_plan = re.sub(r"[^A-Za-z0-9_-]+", "-", str(plan_type or "free").strip().lower())
+    safe_plan = safe_plan.strip("-") or "free"
+    return f"codex-{safe_email}-{safe_plan}.json"
+
+
+def _prepare_codex_upload(token_data: dict) -> dict:
+    """Reject non-Codex payloads without dropping valid Codex fields."""
+    if not isinstance(token_data, dict):
+        raise ValueError("Codex 凭证必须是对象")
+    if str(token_data.get("type") or "").strip().lower() != "codex":
+        raise ValueError("只允许上传 type=codex 的凭证")
+    payload = dict(token_data)
+    payload["type"] = "codex"
+    return payload
+
+
